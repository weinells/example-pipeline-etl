flowchart LR
  subgraph Raw[Raw source files]
    src_map[src_customer_device_map.csv]
    src_modem[src_modem_signal.csv]
    src_cmts[src_cmts_signal.csv]
    src_router[src_router_signal.csv]
    src_mtr[src_modem_mtr.csv]
  end

