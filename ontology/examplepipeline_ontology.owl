<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="https://examplepipeline.invalid/ontology/"
  xml:base="https://examplepipeline.invalid/ontology/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#">

  <owl:Ontology rdf:about="https://examplepipeline.invalid/ontology">
    <owl:versionIRI rdf:resource="https://examplepipeline.invalid/ontology/1.0.0"/>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <dcterms:title>ExamplePipeline Ontology</dcterms:title>
    <dcterms:description>Formal OWL representation of the synthetic cable-internet telemetry domain modeled by ExamplePipeline.</dcterms:description>
    <dcterms:creator>ExamplePipeline ETL maintainers</dcterms:creator>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-10</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-10</dcterms:modified>
    <skos:changeNote>Version 1.0.0 establishes the initial vocabulary, hardware hierarchy, topology, feature semantics, and label and prediction provenance.</skos:changeNote>
  </owl:Ontology>

  <!-- Classes -->

  <owl:Class rdf:about="Customer">
    <rdfs:label>Customer</rdfs:label>
    <rdfs:comment>A synthetic customer entity identified by customer.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="Hardware">
    <rdfs:label>Hardware</rdfs:label>
    <rdfs:comment>An abstract superclass for network hardware.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="CustomerDevice">
    <rdfs:subClassOf rdf:resource="Hardware"/>
    <rdfs:label>Customer device</rdfs:label>
    <rdfs:comment>Hardware associated with a customer.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="CompanyHardware">
    <rdfs:subClassOf rdf:resource="Hardware"/>
    <rdfs:label>Company hardware</rdfs:label>
    <rdfs:comment>Hardware operated by the service provider.</rdfs:comment>
    <owl:disjointWith rdf:resource="CustomerDevice"/>
  </owl:Class>

  <owl:Class rdf:about="Modem">
    <rdfs:subClassOf rdf:resource="CustomerDevice"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="belongsToCustomer"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="Customer"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:label>Modem</rdfs:label>
    <rdfs:comment>Customer hardware identified by modem_mac.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="Router">
    <rdfs:subClassOf rdf:resource="CustomerDevice"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="belongsToCustomer"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="Customer"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:label>Router</rdfs:label>
    <rdfs:comment>Customer hardware identified by router_mac.</rdfs:comment>
    <owl:disjointWith rdf:resource="Modem"/>
  </owl:Class>

  <owl:Class rdf:about="CMTS">
    <rdfs:subClassOf rdf:resource="CompanyHardware"/>
    <rdfs:label>CMTS</rdfs:label>
    <rdfs:comment>Company hardware representing a cable modem termination system. The current data contains CMTS-side measurements but no CMTS identifier.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="TelemetryMeasurement">
    <rdfs:label>Telemetry measurement</rdfs:label>
    <rdfs:comment>A synthetic measurement associated with network hardware. Measurement units are unspecified.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="FeatureVector">
    <rdfs:label>Feature vector</rdfs:label>
    <rdfs:comment>A combined set of telemetry features for a customer, modem, and router mapping.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="ServiceQualityLabel">
    <rdfs:label>Service quality label</rdfs:label>
    <rdfs:comment>A rule-derived binary service-quality target.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="Prediction">
    <rdfs:label>Prediction</rdfs:label>
    <rdfs:comment>A persisted-model output.</rdfs:comment>
    <owl:disjointWith rdf:resource="ServiceQualityLabel"/>
  </owl:Class>

  <owl:Class rdf:about="ServiceQualityRule">
    <rdfs:label>Service quality rule</rdfs:label>
    <rdfs:comment>A documented rule that derives a service-quality label from telemetry quality conditions.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="PersistedModel">
    <rdfs:label>Persisted model</rdfs:label>
    <rdfs:comment>A saved model used to produce predictions from feature vectors.</rdfs:comment>
  </owl:Class>

  <!-- Object properties -->

  <owl:ObjectProperty rdf:about="belongsToCustomer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="CustomerDevice"/>
    <rdfs:range rdf:resource="Customer"/>
    <owl:inverseOf rdf:resource="hasCustomerDevice"/>
    <rdfs:label>belongs to customer</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="hasCustomerDevice">
    <rdfs:domain rdf:resource="Customer"/>
    <rdfs:range rdf:resource="CustomerDevice"/>
    <rdfs:label>has customer device</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="hasModem">
    <rdfs:domain rdf:resource="Customer"/>
    <rdfs:range rdf:resource="Modem"/>
    <rdfs:subPropertyOf rdf:resource="hasCustomerDevice"/>
    <rdfs:label>has modem</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="hasRouter">
    <rdfs:domain rdf:resource="Customer"/>
    <rdfs:range rdf:resource="Router"/>
    <rdfs:subPropertyOf rdf:resource="hasCustomerDevice"/>
    <rdfs:label>has router</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="isAncestorOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:domain rdf:resource="Hardware"/>
    <rdfs:range rdf:resource="Hardware"/>
    <owl:inverseOf rdf:resource="hasDescendant"/>
    <rdfs:label>is ancestor of</rdfs:label>
    <rdfs:comment>Directed hardware topology. Routers are ancestors of modems and modems are ancestors of CMTS hardware.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="hasDescendant">
    <rdfs:domain rdf:resource="Hardware"/>
    <rdfs:range rdf:resource="Hardware"/>
    <rdfs:label>has descendant</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="hasTelemetryMeasurement">
    <rdfs:domain rdf:resource="FeatureVector"/>
    <rdfs:range rdf:resource="TelemetryMeasurement"/>
    <rdfs:label>has telemetry measurement</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="hasFeatureVector">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="ServiceQualityLabel"/>
    <rdfs:range rdf:resource="FeatureVector"/>
    <rdfs:label>has feature vector</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="isGeneratedByRule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="ServiceQualityLabel"/>
    <rdfs:range rdf:resource="ServiceQualityRule"/>
    <rdfs:label>is generated by rule</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="isPredictionFor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="Prediction"/>
    <rdfs:range rdf:resource="FeatureVector"/>
    <rdfs:label>is prediction for</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="isGeneratedByModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="Prediction"/>
    <rdfs:range rdf:resource="PersistedModel"/>
    <rdfs:label>is generated by model</rdfs:label>
  </owl:ObjectProperty>

  <!-- Datatype properties -->

  <owl:DatatypeProperty rdf:about="customerIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="Customer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>customer identifier</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="modemIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="Modem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>modem identifier</rdfs:label>
    <rdfs:comment>Maps to synthetic modem_mac; it is not a literal MAC address.</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="routerIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="Router"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>router identifier</rdfs:label>
    <rdfs:comment>Maps to synthetic router_mac; it is not a literal MAC address.</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="modemRx">
    <rdfs:domain rdf:resource="FeatureVector"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>modem receive measurement</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="modemTx">
    <rdfs:domain rdf:resource="FeatureVector"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>modem transmit measurement</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="cmtsRx">
    <rdfs:domain rdf:resource="FeatureVector"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>CMTS receive measurement</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="cmtsTx">
    <rdfs:domain rdf:resource="FeatureVector"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>CMTS transmit measurement</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="routerSnr">
    <rdfs:domain rdf:resource="FeatureVector"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>router signal-to-noise ratio</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="mtr">
    <rdfs:domain rdf:resource="FeatureVector"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>MTR measurement</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="badServiceValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="ServiceQualityLabel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label>bad service value</rdfs:label>
    <rdfs:comment>True when at least three documented quality conditions are breached.</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="predictedBadServiceValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="Prediction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>predicted bad service value</rdfs:label>
  </owl:DatatypeProperty>

</rdf:RDF>
